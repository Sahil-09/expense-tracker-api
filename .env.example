# Required. A real Mongo connection string.
# Set MONGO_USER / MONGO_PASSWORD below; docker-compose builds this URI itself. When
# running the API outside compose it must carry credentials, since auth is on.
MONGO_URI=mongodb://localhost:27017/expense-tracker

# Required. docker-compose uses these to enable Mongo auth and to build MONGO_URI.
# Mongo's port is never published to the host, so this user is only reachable from inside
# the compose network.
MONGO_USER=expense
MONGO_PASSWORD=change-me-openssl-rand-hex-24

# Required. Two DIFFERENT long random strings. Generate with: openssl rand -hex 32
# Never reuse one for both — that would let a leaked access secret mint refresh tokens.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-a-different-openssl-rand-hex-32

# Required.
PORT=3000

# Optional. Comma-separated browser origins. Native apps send no Origin, so this can be
# left empty. It exists so a web client is never allowed by accident.
CORS_ORIGINS=

# Optional. Refresh token lifetime in days.
REFRESH_TTL_DAYS=30

# Optional, and this is the whole account model.
#
# There is no signup form that anyone on the internet can reach. Accounts are created by
# POST /auth/register with the code below, which you hand to the people you trust. Leave
# it unset and that route is closed entirely.
# Minimum 12 characters. Generate with: openssl rand -hex 24
SIGNUP_CODE=change-me-openssl-rand-hex-24

# Optional, for the iOS Shortcut that pushes bank SMS to POST /sms without the app.
#
# An access token lasts 15 minutes and a Shortcut cannot refresh it, so this is a
# long-lived token instead. It maps to exactly one account: SMS_USER_EMAIL. Both must be
# set together. Revoke by changing the token and redeploying.
# Minimum 12 characters. Generate with: openssl rand -hex 24
# SMS_INGEST_TOKEN=change-me-openssl-rand-hex-24
# SMS_USER_EMAIL=you@example.com

# Optional, and password reset is inert without BOTH of these.
#
# POST /auth/forgot-password mails an 8-digit code to the address, valid for 15 minutes and
# usable once, and POST /auth/reset-password takes it with a new password.
# RESEND_API_KEY is from resend.com; MAIL_FROM must be on a sending domain you have verified
# there, or it will only ever deliver to your own Resend account address.
# Unset means both routes still return 200, no mail is sent, and nobody is told. That is
# deliberate — a failed mailer must not become an account-existence oracle — but it also
# means a typo in the key looks exactly like success.
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=expense-tracker@yourdomain.com